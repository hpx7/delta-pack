{
  "type": "record",
  "name": "User",
  "namespace": "Avro.User",
  "fields": [
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "age",
      "type": "long"
    },
    {
      "name": "weight",
      "type": "float"
    },
    {
      "name": "married",
      "type": "boolean"
    },
    {
      "name": "hairColor",
      "type": {
        "type": "enum",
        "name": "HairColor",
        "symbols": [
          "BLACK",
          "BROWN",
          "BLOND",
          "RED",
          "WHITE",
          "OTHER"
        ]
      }
    },
    {
      "name": "address",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Address",
          "fields": [
            {
              "name": "street",
              "type": "string"
            },
            {
              "name": "zip",
              "type": "string"
            },
            {
              "name": "state",
              "type": "string"
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "children",
      "type": {
        "type": "array",
        "items": "User"
      }
    },
    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": "string"
      }
    },
    {
      "name": "preferredContact",
      "type": [
        "null",
        {
          "type": "record",
          "name": "EmailContact",
          "fields": [
            {
              "name": "email",
              "type": "string"
            }
          ]
        },
        {
          "type": "record",
          "name": "PhoneContact",
          "fields": [
            {
              "name": "phone",
              "type": "string"
            },
            {
              "name": "extension",
              "type": [
                "null",
                "long"
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    }
  ]
}
